<div id="helmet-client" data-pair-code={@pairing_code}
     class="fixed inset-0 z-50 h-dvh w-screen select-none overflow-hidden bg-black text-white"
     style="touch-action: none; background: #000;">
  <%!-- The actual display is one full-screen canvas with two *nonoverlapping*
       scissored eye viewports; no duplicate canvases or video stream. --%>
  <canvas id="helmet-viewport" class="absolute inset-0 block h-full w-full" hidden></canvas>

  <%!-- Each SBS eye gets its own fixed, compact, read-only network display.
       Separate from the WebGL cockpit so it cannot clip or move with head pose. --%>
  <div id="helmet-bandwidth-sbs" class="helmet-bandwidth-sbs" hidden
       aria-label="Estimated network data bandwidth in both headset eyes">
    <div class="helmet-bandwidth-eye" data-helmet-bandwidth-eye>
      <div class="helmet-bandwidth-card">
        <span data-net-label>NET / JSON EST.</span>
        <strong data-net-rx>RX 0 B/s</strong>
        <strong data-net-tx>TX 0 B/s</strong>
        <small data-net-note>5s AVG - excl. assets/TLS</small>
      </div>
    </div>
    <div class="helmet-bandwidth-eye" data-helmet-bandwidth-eye aria-hidden="true">
      <div class="helmet-bandwidth-card">
        <span data-net-label>NET / JSON EST.</span>
        <strong data-net-rx>RX 0 B/s</strong>
        <strong data-net-tx>TX 0 B/s</strong>
        <small data-net-note>5s AVG - excl. assets/TLS</small>
      </div>
    </div>
  </div>

  <%!-- Encounter holds and surrender offers are drawn inside the stereo
       cockpit HUD (StereoSpaceView.updateHud), so they follow lens
       calibration and have real depth instead of flat 50/50 DOM cards. --%>

  <div id="helmet-message" hidden
       class="pointer-events-none absolute inset-x-0 top-1/2 z-20 mx-auto max-w-md -translate-y-1/2 px-6 text-center text-sm text-cyan-100"
       role="status"></div>

  <%!-- Minimal setup screen: the one Enter VR gesture starts head tracking
       and requests fullscreen. The relay button validates a ONE-TIME Tauri
       invitation, not the ordinary Phoenix connection. --%>
  <div id="helmet-setup"
       class="absolute inset-0 z-30 flex items-center justify-center bg-black/95 px-5 py-6">
    <div class="w-full max-w-sm space-y-4 rounded-xl border border-cyan-700/60 bg-slate-950 px-5 py-6 text-center">
      <h1 class="text-lg font-bold tracking-widest text-cyan-200">PILOT HMD</h1>
      <p class="text-sm text-slate-300">Head tracking starts when you enter VR.</p>

      <button id="helmet-fullscreen" type="button"
              class="w-full rounded-lg border border-cyan-300 bg-cyan-800 px-5 py-3 text-sm font-bold tracking-wide text-white">
        ENTER VR
      </button>

      <%!-- QR carries the fragment-only local relay invitation.
           No additional manual link copying or button is needed on phone. --%>
      <p id="helmet-relay-result" hidden role="status" aria-live="polite"
         class="rounded-md border border-cyan-700/60 px-2 py-1 text-xs text-cyan-200"></p>

      <p id="helmet-tracking-status" hidden role="status"
         class="text-xs text-amber-200"></p>
      <p id="helmet-fullscreen-hint" hidden role="status"
         class="text-xs text-amber-200"></p>

      <label class="flex items-center justify-center gap-2 text-xs text-slate-400">
        <input id="helmet-lens-distortion" type="checkbox" class="accent-cyan-500" />
        Lens distortion correction (beta)
      </label>

      <%!-- Emergency browser fallback: only exposed after a fullscreen error. --%>
      <button id="helmet-windowed" hidden type="button"
              class="text-xs text-slate-400 underline underline-offset-4">
        Continue without fullscreen
      </button>
    </div>
  </div>
</div>
