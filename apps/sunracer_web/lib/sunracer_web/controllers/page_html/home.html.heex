<div id="landing-page" class="nova-title-screen">
  <SunracerWeb.TitleSettings.menu />
  <main class="nova-main">
    <header class="nova-brand">
      <h1 id="nova-title" class="nova-wordmark">Space<span>Nova</span></h1>
      <p class="nova-tagline">Space exploration <span>·</span> Trade <span>·</span> Combat <span>·</span> Adventure</p>
    </header>
    <nav class="nova-menu" aria-label="SpaceNova main menu">
      <.link href="https://github.com/bushman77/SunRacer/releases/latest" id="primary-launch-link" class="nova-button nova-button-primary">
        <.icon name="hero-arrow-down-tray" class="size-6" />
        <span>Download desktop client</span>
      </.link>
      <.link :if={!@current_player} href={~p"/login"} id="nova-account-login-link" class="nova-button">
        <.icon name="hero-user" class="size-5" />
        <span>Account sign in</span>
      </.link>
      <.link :if={!@current_player} href={~p"/register"} id="hero-register-link" class="nova-button">
        <.icon name="hero-user-plus" class="size-5" />
        <span>Create account</span>
      </.link>
      <.link :if={@current_player} href={~p"/equipment"} id="nova-equipment-link" class="nova-button">
        <.icon name="hero-cube" class="size-5" />
        <span>Equipment</span>
      </.link>
      <.link :if={@current_player} href={~p"/logout"} method="delete" id="nova-logout-link" class="nova-button">
        <.icon name="hero-arrow-right-on-rectangle" class="size-5" />
        <span>Sign out</span>
      </.link>
      <div :if={!@current_player} class="nova-account-links">
        <.link href={~p"/forgot-password"}>Forgot password?</.link>
        <.link href={~p"/register/resend"}>Resend verification</.link>
      </div>
    </nav>
    <div class="nova-description">
      <p>YOUR SHIP. YOUR CHOICES. AN ENTIRE SYSTEM.</p>
      <p>Chart your course through a living Solar System. Trade, explore, fight and survive among the worlds of Sol.</p>
    </div>
  </main>
  <footer class="nova-footer">
    <span>SpaceNova · Solar System playtest</span>
    <span>Desktop client · Live multiplayer</span>
  </footer>
</div>
