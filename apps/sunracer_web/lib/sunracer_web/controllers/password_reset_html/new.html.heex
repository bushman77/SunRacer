<div class="hud-screen hud-auth-screen">
  <div class="hud-auth-ambient" aria-hidden="true"></div>
  <main class="hud-auth-panel mx-auto my-16 w-full max-w-lg rounded-2xl border border-cyan-300/20 bg-slate-950/85 p-8 text-slate-100">
    <p class="text-xs font-bold uppercase tracking-widest text-cyan-300">SUNRACER / ACCOUNT RECOVERY</p>
    <h1 class="mt-4 text-3xl font-black">Forgot your password?</h1>
    <p class="mt-4 text-sm leading-7 text-slate-300">Enter your verified account email. A single-use recovery link expires after 30 minutes.</p>
    <p :if={!@email_enabled} class="mt-6 text-sm text-amber-200">Email delivery is not configured on this server.</p>
    <.form :if={@email_enabled} for={@form} id="pilot-recovery-form" action={~p"/forgot-password"} method="post" class="mt-7 space-y-5">
      <.input field={@form[:email]} type="email" label="Account email" autocomplete="email" required maxlength="260" class="hud-field mt-2 w-full rounded-xl border border-slate-700 bg-slate-900/90 px-4 py-3 text-sm text-white" />
      <button type="submit" class="hud-cta w-full rounded-xl bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950">Send password reset link</button>
    </.form>
    <.link href={~p"/register/resend"} class="mt-6 block text-xs text-cyan-200">Need to verify your email first?</.link>
    <.link href={~p"/login"} class="mt-7 inline-block text-sm font-bold text-cyan-200">Back to pilot sign in</.link>
  </main>
</div>
