<Layouts.auth id="pilot-reset-page" kicker="ACCOUNT RECOVERY // SOL-01" headline="YOUR PILOT." headline_tail="YOUR JOURNEY." copy="Recover access to your pilot and continue your adventure.">
    <p class="text-xs font-bold uppercase tracking-widest text-cyan-300">SPACENOVA / ACCOUNT RECOVERY</p>
    <h1 class="mt-4 text-3xl font-black">Choose a new password</h1>
    <p class="mt-4 text-sm leading-7 text-slate-300">Your ship and progress remain unchanged. Existing pilot sessions will be signed out.</p>
    <p :if={@error} role="alert" class="mt-4 text-sm text-amber-200">{@error}</p>
    <.form for={@form} id="pilot-reset-form" action={~p"/reset-password"} method="post" class="mt-7 space-y-5">
      <.input field={@form[:id]} type="hidden" />
      <.input field={@form[:token]} type="hidden" />
      <.input field={@form[:password]} type="password" label="New password" autocomplete="new-password" required minlength="8" maxlength="72" class="hud-field mt-2 w-full rounded-xl border border-slate-700 bg-slate-900/90 px-4 py-3 text-sm text-white" />
      <.input field={@form[:password_confirmation]} type="password" label="Confirm new password" autocomplete="new-password" required minlength="8" maxlength="72" class="hud-field mt-2 w-full rounded-xl border border-slate-700 bg-slate-900/90 px-4 py-3 text-sm text-white" />
      <button type="submit" class="hud-cta w-full rounded-xl bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950">Reset password</button>
    </.form>
    <.link href={~p"/forgot-password"} class="mt-6 block text-xs text-cyan-200">Request a new recovery link</.link>
    <.link href={~p"/login"} class="mt-7 inline-block text-sm font-bold text-cyan-200">Back to pilot sign in</.link>
  </Layouts.auth>
