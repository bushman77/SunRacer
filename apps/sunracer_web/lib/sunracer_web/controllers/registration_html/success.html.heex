<Layouts.auth id="registration-success" kicker="PILOT RECRUITMENT // SOL-01" headline="YOUR JOURNEY" headline_tail="BEGINS HERE." copy="Activate your callsign to begin your first flight.">
    <div class="text-center">
    <div class="mx-auto grid size-16 place-items-center rounded-2xl border border-cyan-300/25 bg-cyan-300/10">
      <.icon name="hero-envelope" class="size-8 text-cyan-300" />
    </div>
    <p class="mt-7 text-xs font-bold uppercase tracking-[0.25em] text-cyan-300">SPACENOVA / PILOT RECRUITMENT</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white">Check your inbox.</h1>
    <p class="mt-5 text-sm leading-7 text-slate-300">If the confirmation email was delivered, follow its verification link to activate your new pilot account. You cannot sign in until verification is complete.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <.link href={~p"/register/resend"} id="request-confirmation-link" class="rounded-xl border border-cyan-300/30 px-5 py-3 text-sm font-bold text-cyan-100">Resend confirmation</.link>
      <.link href={~p"/login"} class="hud-cta rounded-xl bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-200">Pilot sign in</.link>
      <.link href={~p"/"} class="rounded-xl border border-slate-600 px-5 py-3 text-sm font-bold text-slate-100 transition hover:border-cyan-300">Back to SpaceNova</.link>
    </div>
      </div>
</Layouts.auth>
